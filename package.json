{
  "name": "wolf-forge-platform",
  "version": "1.0.0",
  "description": "Internal operations platform for Wolf Forge.",
  "main": "dist/index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --webpack",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "memory:sync": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/sync-ai-memory-to-obsidian.ps1",
    "setup:frontend": "tsx scripts/setup-phase3a-local.ts",
    "qa:local-login": "tsx scripts/qa-local-login.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "supabase test db --local",
    "types:db": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts",
    "test:integration": "tsx scripts/phase2b-integration.ts",
    "lint:db": "supabase db lint --local --level error --fail-on error",
    "smoke:backend": "tsx scripts/backend-smoke.ts",
    "security:secrets": "tsx scripts/security/scan-secrets.ts",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "qa:auth-cookies": "tsx scripts/qa-c22-auth-cookies.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UplineTonyuo/wolf-forge-platform.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/UplineTonyuo/wolf-forge-platform/issues"
  },
  "homepage": "https://github.com/UplineTonyuo/wolf-forge-platform#readme",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "supabase": "^2.113.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@lexical/link": "^0.51.0",
    "@lexical/list": "^0.51.0",
    "@lexical/markdown": "^0.51.0",
    "@lexical/react": "^0.51.0",
    "@lexical/rich-text": "^0.51.0",
    "@lexical/selection": "^0.51.0",
    "@lexical/utils": "^0.51.0",
    "@sentry/nextjs": "^11.0.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/speed-insights": "^2.0.0",
    "botid": "1.5.11",
    "lexical": "^0.51.0",
    "lucide-react": "^1.48.0",
    "music-metadata": "11.16.1",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "^2.17.7",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  }
}
