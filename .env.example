# Local development placeholders only. Never commit real credentials.
# `npm.cmd run setup:frontend` writes the public local values to ignored `.env.local`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SECRET_KEY=replace-with-local-secret-key

# Local QA Quick Access (Instruction 03). Development only, never set these on
# Vercel Production or Preview — the code fails closed without them there.
# LOCAL_UI_QA_BYPASS=true auto-signs the local QA account in on loopback
# requests after `npm run qa:local-login` has written the gitignored
# credentials file. Leave unset or false everywhere else.
# LOCAL_UI_QA_BYPASS=
# LOCAL_QA_LAN_DEVICES=192.168.1.95 — comma-separated LAN device IPs that may
# reach the app on non-loopback hosts when `npm run dev:lan` is running.
# Unset (or empty) refuses every non-loopback peer; the developer's own
# machine always passes. `npm run qa:tenants` seeds the matching host rows.
# LOCAL_QA_LAN_DEVICES=

# Operations Google Sheets (server-only). Configure these names in every
# Preview and Production environment before department workspaces can load.
# Never prefix them with NEXT_PUBLIC_. Keep the private key secret, and give
# the service-account email Viewer access to each configured workbook.
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SHEETS_SERVICE_ACCOUNT_PRIVATE_KEY=
PODCAST_SEO_SPREADSHEET_ID=
CONTENT_WORKFLOW_SPREADSHEET_ID=
ON_PAGE_SEO_SPREADSHEET_ID=
GMB_MANAGEMENT_SPREADSHEET_ID=
YOUTUBE_SEO_SPREADSHEET_ID=
WEBSITE_BUILDER_SPREADSHEET_ID=
TECHNICAL_SEO_SPREADSHEET_ID=
OFF_PAGE_SEO_SPREADSHEET_ID=

# Server-only secret for the existing cleanup and daily intake maintenance jobs.
# Use a random value of at least 32 characters. Leaving it blank disables these routes.
CRON_SECRET=
# Optional private Ticket voice/video calls. Server key never belongs in NEXT_PUBLIC_.
DAILY_CALLS_ENABLED=0
DAILY_DOMAIN=wolfforge.daily.co
DAILY_API_KEY=
