# Shared Obsidian project memory, symlinked outside the repo.
# Tailwind follows unignored paths when scanning sources, and this one leaves
# the filesystem root, which breaks the production build.
.ai-memory

# Generated local-only QA login credential (scripts/qa-local-login.ts). Never commit.
.qa-local-credentials*.json

# Local Sentry source-map upload credential. Never commit.
.env.sentry-build-plugin

# Local Graphify graph artifacts from the approved trial.
/graphify-out/

# Machine-local Claude Code settings and permissions.
/.claude/settings.local.json

# Local Python environments and bytecode.
.venv/
__pycache__/
*.py[cod]
